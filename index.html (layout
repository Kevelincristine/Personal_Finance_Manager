<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title>Feira Nuzzi</title>
  <style>
    :root {
      --bg: #0f0f0f;
      --bg-header: #161616;
      --texto: #f5f5f5;
      --texto-sec: #a1a1a6;
      --azul: #0A84FF;
      --vermelho: #FF453A;
      --verde: #30D158;
      --borda: #2c2c2e;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
    html, body { height: 100%; width: 100%; overflow: hidden; background: var(--bg); color: var(--texto); }
    .app { width: 100%; height: 100%; height: 100dvh; display: flex; flex-direction: column; position: relative; background: var(--bg); }
    .screen { display: none; flex-direction: column; height: 100%; width: 100%; position: absolute; top: 0; left: 0; background: var(--bg); }
    .screen.active { display: flex; }

    .header { padding: 12px 16px 10px; padding-top: max(12px, env(safe-area-inset-top)); background: var(--bg-header); border-bottom: 1px solid var(--borda); flex-shrink: 0; z-index: 20; }
    .top-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
    .logo-area { display: flex; align-items: center; gap: 10px; }
    .logo-simbolo { width: 48px; height: 48px; border-radius: 50%; object-fit: contain; border: none; background: transparent; display: block; }
    .logo-texto { font-size: 22px; font-weight: 800; color: var(--azul); letter-spacing: -0.5px; }

    .search-box { display: flex; align-items: center; background: #2c2c2e; border-radius: 14px; padding: 13px 16px; gap: 10px; }
    .search-box input { border: none; background: transparent; outline: none; flex: 1; font-size: 15px; color: var(--texto); }
    .search-box input::placeholder { color: #8e8e93; }

    .stores-scroll { padding: 16px 0 8px 16px; overflow-x: auto; white-space: nowrap; scrollbar-width: none; flex-shrink: 0; background: var(--bg); }
    .stores-scroll::-webkit-scrollbar { display: none; }
    .store-item { display: inline-flex; flex-direction: column; align-items: center; margin-right: 16px; width: 70px; }
    .store-logo { width: 62px; height: 62px; border-radius: 50%; object-fit: cover; border: 2.5px solid #3a3a3c; background: #2c2c2e; }
    .store-name { font-size: 11.5px; color: var(--texto-sec); margin-top: 6px; text-align: center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; width: 100%; font-weight: 500; }

    .content { flex: 1; overflow-y: auto; -webkit-overflow-scrolling: touch; padding: 8px 16px; padding-bottom: 90px; background: var(--bg); }
    .section-header { display: flex; justify-content: space-between; align-items: center; margin: 10px 0 12px; }
    .section-title { font-size: 18px; font-weight: 700; color: var(--texto); }
    .ver-mais { font-size: 14px; color: var(--azul); font-weight: 600; cursor: pointer; }

    .card { display: flex; gap: 12px; padding: 14px 0; border-bottom: 1px solid var(--borda); }
    .card:active { background: #1a1a1c; }
    .card-img { width: 92px; height: 92px; border-radius: 14px; object-fit: cover; flex-shrink: 0; }
    .card-info { flex: 1; display: flex; flex-direction: column; justify-content: space-between; min-width: 0; }
    .card-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; }
    .card-name { font-size: 15.5px; font-weight: 650; color: var(--texto); line-height: 1.25; }
    .status { font-size: 12px; color: var(--verde); font-weight: 600; margin-top: 2px; }
    .card-category { font-size: 12.5px; color: var(--texto-sec); margin-top: 2px; }
    .card-meta { font-size: 12px; color: var(--texto-sec); margin-top: 4px; display: flex; align-items: center; gap: 3px; }
    .star { color: #FFD60A; font-size: 13px; }
    .card-bottom { display: flex; justify-content: space-between; align-items: center; margin-top: 6px; }
    .preco-label { font-size: 12px; color: var(--texto-sec); }
    .price { font-size: 15px; font-weight: 700; color: var(--vermelho); }
    .heart { font-size: 20px; color: #636366; flex-shrink: 0; }

    .bottom-nav { position: absolute; bottom: 0; left: 0; right: 0; height: calc(70px + env(safe-area-inset-bottom)); padding-bottom: env(safe-area-inset-bottom); background: var(--bg-header); border-top: 1px solid var(--borda); display: flex; justify-content: space-around; align-items: center; z-index: 30; }
    .nav-item { display: flex; flex-direction: column; align-items: center; gap: 3px; font-size: 11px; color: #8e8e93; width: 70px; padding: 6px 0; cursor: pointer; }
    .nav-item.active { color: var(--azul); }
    .nav-icon { font-size: 22px; }

    .detail-header { padding: 12px 16px; padding-top: max(12px, env(safe-area-inset-top)); display: flex; align-items: center; gap: 12px; border-bottom: 1px solid var(--borda); flex-shrink: 0; background: var(--bg-header); z-index: 20; }
    .back-btn { width: 40px; height: 40px; border-radius: 50%; background: #2c2c2e; display: flex; align-items: center; justify-content: center; font-size: 18px; border: none; color: var(--texto); font-weight: 600; }
    .detail-title { font-size: 17px; font-weight: 700; flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: var(--texto); }
    .detail-content { flex: 1; overflow-y: auto; -webkit-overflow-scrolling: touch; padding-bottom: 90px; }
    .detail-banner { width: 100%; height: 240px; object-fit: cover; display: block; }
    .detail-body { padding: 20px 16px; }
    .detail-name { font-size: 23px; font-weight: 750; margin-bottom: 4px; line-height: 1.2; color: var(--texto); }
    .detail-category { font-size: 14px; color: var(--texto-sec); margin-bottom: 12px; }
    .detail-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; font-size: 13.5px; color: var(--texto-sec); margin-bottom: 18px; }
    .detail-status { color: var(--verde); font-weight: 600; }
    .detail-desc { font-size: 15px; color: #d1d1d6; line-height: 1.55; margin-bottom: 24px; }
    .btn-reservar { width: 100%; background: var(--vermelho); color: white; border: none; border-radius: 14px; padding: 16px; font-size: 16px; font-weight: 700; margin-bottom: 8px; }
    .btn-reservar:active { opacity: 0.9; transform: scale(0.985); }
    .produtos-title { font-size: 17px; font-weight: 700; margin: 28px 0 12px; color: var(--texto); }
    .produto-item { display: flex; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--borda); }
    .produto-img { width: 72px; height: 72px; border-radius: 12px; object-fit: cover; flex-shrink: 0; }
    .produto-info { flex: 1; min-width: 0; }
    .produto-nome { font-size: 15px; font-weight: 650; color: var(--texto); }
    .produto-desc { font-size: 13px; color: var(--texto-sec); margin-top: 2px; line-height: 1.3; }
    .produto-preco { font-size: 14.5px; font-weight: 700; color: var(--vermelho); margin-top: 6px; }

    .placeholder { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 40px 20px; text-align: center; color: var(--texto-sec); }
    .placeholder-icon { font-size: 48px; margin-bottom: 16px; }
    .placeholder-title { font-size: 20px; font-weight: 700; color: var(--texto); margin-bottom: 8px; }
    .placeholder-text { font-size: 15px; line-height: 1.4; }
    .no-results { text-align: center; padding: 40px 20px; color: var(--texto-sec); font-size: 15px; }
  </style>
</head>
<body>
  <div class="app">
    <div class="screen active" id="home">
      <div class="header">
        <div class="top-bar">
          <div class="logo-area" onclick="irPara('home')">
            <img src="data:image/png;base64," class="logo-simbolo" alt="CCMPR">
            <div class="logo-texto">feira nuzzi</div>
          </div>
        </div>
        <div class="search-box">
          <span style="font-size:16px">🔍</span>
          <input type="text" id="searchInput" placeholder="Buscar por barraca ou produto" oninput="filtrar()">
        </div>
      </div>

      <div class="stores-scroll" id="logos-scroll"></div>

      <div class="content">
        <div class="section-header">
          <div class="section-title">Mais vendidos</div>
          <div class="ver-mais" onclick="abrirMaisVendidos()">Ver mais ›</div>
        </div>
        <div id="lista-barracas"></div>
        <div id="no-results" class="no-results" style="display:none;">Nenhuma barraca encontrada</div>
      </div>
      <div class="bottom-nav" id="nav-home"></div>
    </div>

    <div class="screen" id="mais-vendidos">
      <div class="detail-header">
        <button class="back-btn" onclick="irPara('home')">←</button>
        <div class="detail-title">Mais vendidos</div>
      </div>
      <div class="content" style="padding-top: 8px;"><div id="lista-mais-vendidos"></div></div>
      <div class="bottom-nav" id="nav-mais"></div>
    </div>

    <div class="screen" id="categoria">
      <div class="header"><div class="top-bar"><div class="logo-texto" style="font-size:20px">Categorias</div></div></div>
      <div class="placeholder"><div class="placeholder-icon">🏷️</div><div class="placeholder-title">Nenhuma categoria ainda</div><div class="placeholder-text">Quando as barracas forem cadastradas, elas aparecerão aqui organizadas por categoria.</div></div>
      <div class="bottom-nav" id="nav-categoria"></div>
    </div>

    <div class="screen" id="pedidos">
      <div class="header"><div class="top-bar"><div class="logo-texto" style="font-size:20px">Meus Pedidos</div></div></div>
      <div class="placeholder"><div class="placeholder-icon">📋</div><div class="placeholder-title">Nenhum pedido ainda</div><div class="placeholder-text">Quando você fizer uma reserva, ela aparecerá aqui.</div></div>
      <div class="bottom-nav" id="nav-pedidos"></div>
    </div>

    <div class="screen" id="perfil">
      <div class="header"><div class="top-bar"><div class="logo-texto" style="font-size:20px">Perfil</div></div></div>
      <div class="placeholder"><div class="placeholder-icon">👤</div><div class="placeholder-title">Seu perfil</div><div class="placeholder-text">Em breve você poderá editar seus dados e ver seu histórico.</div></div>
      <div class="bottom-nav" id="nav-perfil"></div>
    </div>

    <div class="screen" id="detail">
      <div class="detail-header">
        <button class="back-btn" onclick="irPara('home')">←</button>
        <div class="detail-title" id="detail-title">Barraca</div>
      </div>
      <div class="detail-content" id="detail-content"></div>
      <div class="bottom-nav" id="nav-detail"></div>
    </div>
  </div>

  <script>
    // Banco de dados zerado — adicione suas barracas aqui seguindo este modelo:
    // { id: 1, nome: "", categoria: "", logo: "", imagem: "", nota: 0, avaliacoes: 0, tempo: "", status: "Aberto", descricao: "", produtos: [ { nome: "", desc: "", preco: "R$ 0,00", img: "" } ] }
    const barracas = [];

    function menorPreco(b) { return b.produtos?.[0]?.preco || "R$ --"; }

    function criarNav(telaAtiva) {
      return `
        <div class="nav-item ${telaAtiva === 'home' || telaAtiva === 'mais-vendidos' ? 'active' : ''}" onclick="irPara('home')"><div class="nav-icon">🏠</div><div>Início</div></div>
        <div class="nav-item ${telaAtiva === 'categoria' ? 'active' : ''}" onclick="irPara('categoria')"><div class="nav-icon">🏷️</div><div>Categoria</div></div>
        <div class="nav-item ${telaAtiva === 'pedidos' ? 'active' : ''}" onclick="irPara('pedidos')"><div class="nav-icon">📋</div><div>Pedidos</div></div>
        <div class="nav-item ${telaAtiva === 'perfil' ? 'active' : ''}" onclick="irPara('perfil')"><div class="nav-icon">👤</div><div>Perfil</div></div>
      `;
    }

    document.getElementById('nav-home').innerHTML = criarNav('home');
    document.getElementById('nav-categoria').innerHTML = criarNav('categoria');
    document.getElementById('nav-pedidos').innerHTML = criarNav('pedidos');
    document.getElementById('nav-perfil').innerHTML = criarNav('perfil');
    document.getElementById('nav-detail').innerHTML = criarNav('home');
    document.getElementById('nav-mais').innerHTML = criarNav('mais-vendidos');

    function criarCard(b) {
      return `<div class="card" onclick="abrirBarraca(${b.id})">
        <img src="${b.imagem}" class="card-img" alt="${b.nome}">
        <div class="card-info">
          <div>
            <div class="card-top"><div class="card-name">${b.nome}</div><div class="heart">♡</div></div>
            <div class="status">● ${b.status}</div>
            <div class="card-category">${b.categoria}</div>
            <div class="card-meta"><span class="star">★</span> ${b.nota} (${b.avaliacoes.toLocaleString('pt-BR')}) • ${b.tempo}</div>
          </div>
          <div class="card-bottom"><div class="preco-label">A partir de</div><div class="price">${menorPreco(b)}</div></div>
        </div>
      </div>`;
    }

    function renderizar(lista = barracas) {
      const logos = document.getElementById('logos-scroll');
      const listaEl = document.getElementById('lista-barracas');
      const noResults = document.getElementById('no-results');
      logos.innerHTML = ''; listaEl.innerHTML = '';
      if (lista.length === 0) { noResults.style.display = 'block'; return; }
      noResults.style.display = 'none';
      lista.forEach(b => {
        logos.innerHTML += `<div class="store-item" onclick="abrirBarraca(${b.id})">
          <img src="${b.logo}" class="store-logo" alt="${b.nome}" onerror="this.src='https://via.placeholder.com/64/2c2c2e/a1a1a6?text=Logo'">
          <div class="store-name">${b.nome}</div>
        </div>`;
        listaEl.innerHTML += criarCard(b);
      });
    }

    function filtrar() {
      const termo = document.getElementById('searchInput').value.toLowerCase().trim();
      renderizar(termo ? barracas.filter(b => b.nome.toLowerCase().includes(termo) || b.categoria.toLowerCase().includes(termo)) : barracas);
    }

    function abrirMaisVendidos() {
      document.getElementById('lista-mais-vendidos').innerHTML = barracas.map(criarCard).join('');
      irPara('mais-vendidos');
    }

    function irPara(tela) {
      document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
      document.getElementById(tela).classList.add('active');
    }

    function abrirBarraca(id) {
      const b = barracas.find(x => x.id === id);
      if (!b) return;
      document.getElementById('detail-title').textContent = b.nome;
      document.getElementById('detail-content').innerHTML = `
        <img src="${b.imagem}" class="detail-banner" alt="${b.nome}">
        <div class="detail-body">
          <div class="detail-name">${b.nome}</div>
          <div class="detail-category">${b.categoria}</div>
          <div class="detail-meta"><span class="star">★</span> ${b.nota} (${b.avaliacoes.toLocaleString('pt-BR')}) • <span class="detail-status">● ${b.status}</span> • ${b.tempo}</div>
          <div class="detail-desc">${b.descricao}</div>
          <button class="btn-reservar" onclick="alert('Reserva iniciada!')">Reservar agora</button>
          <div class="produtos-title">Produtos</div>
          ${b.produtos.map(p => `<div class="produto-item"><img src="${p.img}" class="produto-img"><div class="produto-info"><div class="produto-nome">${p.nome}</div><div class="produto-desc">${p.desc}</div><div class="produto-preco">${p.preco}</div></div></div>`).join('')}
        </div>`;
      irPara('detail');
      document.getElementById('detail-content').scrollTop = 0;
    }

    renderizar();
  </script>
</body>
</html>